# Dev config — copy to .env and fill in. Lowest precedence: Vercel team
# defaults and in-app Settings both override these.
# Production will use a backend proxy instead; point REQUESTY_BASE_URL at it then.

REQUESTY_BASE_URL=https://router.requesty.ai/v1
REQUESTY_API_KEY=
DEEPGRAM_API_KEY=
Bot_User_OAuth_Token=
GetOverview_BASE_URL=
GetOverview_Access_Token=
# Asana per-user OAuth. Client id is public (rides in the authorize URL); the secret is
# server-side only in production — it's here for local dev of the /api/asana/* routes.
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=
USER_DISPLAY_NAME=
AUTO_DELETE_DAYS=0
