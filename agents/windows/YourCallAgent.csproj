<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF> <!-- pulls in UIAutomationClient/UIAutomationTypes -->
    <Nullable>enable</Nullable>
    <!-- Required: the source uses List<>/HashSet<>/Dictionary<>/LINQ without spelling out
         System.Collections.Generic or System.Linq. Without this the build fails with CS0246.
         This was missing since the agent was first added, so it had NEVER compiled — the
         "Build Windows name agent" step in release.yml failed on every release, which is why
         Layer 1 speaker names never worked in any installer. -->
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- REQUIRED with PublishSingleFile. Without it .NET bundles only the MANAGED assemblies and
         leaves the native ones (WPF/UIAutomation: PresentationNative_cor3, wpfgfx_cor3, vcruntime…)
         as loose files beside the exe. build-agent.mjs copies just the exe into agents/dist, so
         every UIA call died with DllNotFoundException inside OSVersionHelper -> the agent could not
         enumerate a single window and silently emitted no roster for whole meetings. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>YourCallAgent</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
</Project>
